# -----------------------------
# Server
# -----------------------------
server <- function(input, output, session) {
  addResourcePath("root", ".")
  
  current_council <- reactiveVal(NULL)
  current_species <- reactiveVal(NULL)
  current_sedar <- reactiveVal(NULL)
  
  # Sidebar UI
  output$dynamic_sidebar <- renderUI({
    if (is.null(current_council())) {
      tagList(
        h4("Select a Council / Species Group"),
        div(class="fish-grid", lapply(names(council_data), function(cn) {
          actionButton(
            paste0("council_", cn),
            label = div(
              tags$img(src = council_data[[cn]]$logo, alt = cn),
              div(class="fish-label", cn)
            ),
            class = "council-button"
          )
        }))
      )
    } else if (is.null(current_species())) {
      sp_sedar <- council_data[[current_council()]]$species_sedar
      tagList(
        actionButton("back_main", "Back", class = "btn btn-secondary", width = "100%"),
        br(), br(),
        h4("Select a Species"),
        div(class="fish-grid", lapply(names(sp_sedar), function(sp) {
          actionButton(
            paste0("species_", gsub(" ","_",sp)),
            label = div(
              tags$img(src = paste0("root/", gsub(" ","_",sp), ".png"), alt = sp),
              div(class="fish-label", sp)
            ),
            class = "fish-button"
          )
        }))
      )
    } else {
      sp <- current_species()
      sp_sedar <- council_data[[current_council()]]$species_sedar
      extra_sedar <- council_data[[current_council()]]$extra_sedar
      sedars <- unique(c(sp_sedar[[sp]], extra_sedar[[sp]]))
      sedars <- sedars[!is.na(sedars)]
      tagList(
        actionButton("back_species", "Back", class = "btn btn-secondary", width = "100%"),
        br(), br(),
        h4(paste("SEDAR Documents for", sp)),
        lapply(sedars, function(sd) {
          actionButton(paste0("sedar_", sd), sd, width="100%")
        })
      )
    }
  })
  
  # Back buttons
  observeEvent(input$back_main, {
    current_council(NULL)
    current_species(NULL)
    current_sedar(NULL)
  })
  
  observeEvent(input$back_species, {
    current_species(NULL)
    current_sedar(NULL)
  })
  
  # Council observers
  lapply(names(council_data), function(cn){
    observeEvent(input[[paste0("council_", cn)]], {
      current_council(cn)
      current_species(NULL)
      current_sedar(NULL)
    })
  })
  
  # Species observers
  observe({
    req(current_council())
    sp_sedar <- council_data[[current_council()]]$species_sedar
    lapply(names(sp_sedar), function(sp){
      observeEvent(input[[paste0("species_", gsub(" ","_",sp))]], {
        current_species(sp)
        current_sedar(NULL)
      })
    })
  })
  
  # SEDAR observers (only for selected species)
  observeEvent(current_species(), {
    req(current_council(), current_species())
    sp <- current_species()
    species_sedars <- council_data[[current_council()]]$species_sedar[[sp]]
    extra <- council_data[[current_council()]]$extra_sedar[[sp]]
    sedars <- unique(c(species_sedars, extra))
    lapply(sedars, function(sd) {
      observeEvent(input[[paste0("sedar_", sd)]], {
        current_sedar(sd)
      }, ignoreInit = TRUE)
    })
  })
  
  # Show PDF modal
  observeEvent(current_sedar(), {
    req(current_sedar(), current_species())
    showModal(modalDialog(
      title = paste(current_species(), "-", current_sedar(), "Resource Record"),
      tags$iframe(
        src = paste0("root/res_rec_", current_sedar(), ".pdf"),
        width="100%", height="600px"
      ),
      easyClose = TRUE,
      footer = NULL
    ))
    current_sedar(NULL)
  })
  
  # Main panel UI
  output$dynamic_main <- renderUI({
    if (is.null(current_council())) {
      fluidRow(
        h3("Click the cooperator for a species list."),
        tags$img(src="root/SE_map.png", style="width:100%;")
      )
    } else if (is.null(current_species())) {
      fluidRow(
        h3(paste("Welcome to the", council_data[[current_council()]]$title, "Dashboard")),
        p("Select a species on the left to view their research recommendations."),
        tags$img(src = council_data[[current_council()]]$logo, width="45%", alt=current_council())
      )
    } else if (is.null(current_sedar())) {
      fluidRow(
        h3(current_species()),
        p("Choose a SEDAR assessment from the sidebar to view the research recommendations PDF.")
      )
    } else {
      fluidRow(
        h3(paste(current_species(), "-", current_sedar())),
        p("The corresponding SEDAR report has opened in a pop-up window.")
      )
    }
  })
}

# -----------------------------
# Launch app
# -----------------------------
shinyApp(ui, server)
